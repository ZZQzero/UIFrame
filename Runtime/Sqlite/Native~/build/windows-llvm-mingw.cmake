set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES UFSQLITE_LLVM_MINGW)
if(NOT UFSQLITE_LLVM_MINGW)
  message(FATAL_ERROR "Pass the LLVM-MinGW toolchain root as UFSQLITE_LLVM_MINGW")
endif()
if(CMAKE_HOST_WIN32)
  set(UFSQLITE_COMPILER_SUFFIX .exe)
endif()
set(CMAKE_C_COMPILER "${UFSQLITE_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang${UFSQLITE_COMPILER_SUFFIX}")
set(CMAKE_CXX_COMPILER "${UFSQLITE_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++${UFSQLITE_COMPILER_SUFFIX}")
set(CMAKE_RC_COMPILER "${UFSQLITE_LLVM_MINGW}/bin/x86_64-w64-mingw32-windres${UFSQLITE_COMPILER_SUFFIX}")
set(CMAKE_FIND_ROOT_PATH "${UFSQLITE_LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
